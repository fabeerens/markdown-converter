# Kopieer naar .env (genegeerd door git en door de image) en haal het commentaarteken weg bij wat je
# nodig hebt. Alles is optioneel: zonder sleutel blijft alleen het AI-opschoonpaneel uitgeschakeld.
# Een gezette maar lege variabele is geen goed idee (PORT= geeft een fout in app.py); laat ze uit.

# Poort van de app zelf (app.py); docker-compose bindt 127.0.0.1:3007 op 5001 in de container.
# PORT=5001

# AI-opschoning via OpenRouter (mdconv/cleanup/config.py).
# OPENROUTER_API_KEY=
# LLM_MODEL=
# OPENROUTER_BASE_URL=

# Franse rechtspraak via Judilibre (mdconv/sources/fr_judilibre.py); alleen met een PISTE-account.
# PISTE_JUDILIBRE_PROD_KEY=
# PISTE_JUDILIBRE_PROD_SECRET=

# Alleen voor de tests, niet voor de app: de map van de juridische kennisbank, voor de twee tests die
# een gouden voorbeeld daaruit lezen (tests/kbwortel.py). Niet gezet: ~/Documents/kb, dan ../kb, en
# zonder kb slaan ze over met de reden. Gezet maar ontbrekend is een fout.
# KB_ROOT=
